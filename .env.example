# Copy to .env for local development. Never commit .env.
# Every external integration no-ops cleanly when its variables are absent.

# --- Database (required) ---------------------------------------------------
# Any Postgres URL. Locally: a Postgres.app/Homebrew database, or `pnpm prisma dev`.
# On Vercel the Prisma Postgres integration sets this (prisma+postgres://...).
DATABASE_URL="postgresql://localhost:5432/tahoebike"

# --- Admin sign-in (required for /admin) -----------------------------------
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <site url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Random 32+ byte secret: `openssl rand -base64 32`
AUTH_SECRET=""
# Public URL of the deployment. Vercel sets this automatically via VERCEL_URL;
# set it explicitly for local dev and for the production domain.
AUTH_URL="http://localhost:3000"
# Set to "true" only in preview deployments where the URL is not known ahead of time.
AUTH_TRUST_HOST="true"
# Local development only: signs this address in to /admin without Google. Honoured by
# `next dev` alone (NODE_ENV=development); builds and deployments ignore it.
ADMIN_DEV_EMAIL=""
# Comma-separated addresses that `pnpm db:seed` allowlists for /admin (add-only; later
# admins are managed at /admin/users). Unset => the seed adds no admin.
SEED_ADMIN_EMAILS=""

# --- Public site -------------------------------------------------------------
# Canonical origin, used for metadata, sitemap, and absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Feature flags -----------------------------------------------------------
# Which of the site's own forms replace the embedded Google Forms the old site used
# (docs/OPEN_QUESTIONS.md Q16, Q17): a comma-separated list of "valet" and/or "racks",
# or "all" / "none". Unset or "none" (the launch default) => the Google Forms are
# embedded and the native server actions refuse submissions. The Google Form URLs
# live in lib/feature-flags.ts. Takes effect on the next deployment.
# NATIVE_FORMS="none"

# --- Form spam protection (Cloudflare Turnstile) ---------------------------
# Absent => forms skip verification (development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Transactional email (Resend) ------------------------------------------
# Absent => notification emails are logged to the console instead of sent.
RESEND_API_KEY=""
# From address; must be on a domain verified in Resend.
EMAIL_FROM="Lake Tahoe Bicycle Coalition <no-reply@tahoebike.org>"

# --- Image uploads (Vercel Blob) ---------------------------------------------
# Absent => the admin image fields accept pasted URLs only (no upload button).
# Vercel: Storage > Create Blob store, then link it to the project to set this.
BLOB_READ_WRITE_TOKEN=""
